# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Firebase Admin SDK (для push-уведомлений)
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# Telegram Bot Token (для уведомлений в Telegram)
TELEGRAM_BOT_TOKEN=123456789:ABCDEfghijklmnopqrstuvwxyz
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=YourBotUsername

# Google Sheets API
GOOGLE_SHEETS_CREDENTIALS={"type":"service_account",...}

# Cron Secret (для защиты cron endpoints)
CRON_SECRET=your-secret-key-for-cron

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/birthday_app
